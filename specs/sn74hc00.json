  "vectors": [
    {
      "id": "all_pairs",
      "label": "Four NAND truth tables",
      "requirements": [
        "nand_truth"
      ],
      "steps": [
        {
          "set": {},
          "expect": {
            "y1": true,
            "y2": true,
            "y3": true,
            "y4": true
          }
        },
        {
          "set": {
            "b1": true,
            "b2": true,
            "b3": true,
            "b4": true
          },
          "expect": {
            "y1": true,
            "y2": true,
            "y3": true,
            "y4": true
          }
        },
        {
          "set": {
            "a1": true,
            "a2": true,
            "a3": true,
            "a4": true,
            "b1": false,
            "b2": false,
            "b3": false,
            "b4": false
          },
          "expect": {
            "y1": true,
            "y2": true,
            "y3": true,
            "y4": true
          }
        },
        {
          "set": {
            "b1": true,
            "b2": true,
            "b3": true,
            "b4": true
          },
          "expect": {
            "y1": false,
            "y2": false,
            "y3": false,
            "y4": false
          }
        }
      ]
    },
    {
      "id": "independent",
      "label": "One channel changes at a time",
      "requirements": [
        "isolation"
      ],
      "steps": [
        {
          "set": {
            "a1": true,
            "b1": true
          },
          "expect": {
            "y1": false,
            "y2": true,
            "y3": true,
            "y4": true
          }
        },
        {
          "set": {
            "a3": true,
            "b3": true
          },
          "expect": {
            "y1": false,
            "y2": true,
            "y3": false,
            "y4": true
          }
        }
      ]
    }
  ],
  "assumptions": [
    "Inputs already meet valid CMOS high/low voltage requirements; VCC and ground are valid.",
    "Two-valued, zero-delay functional logic; connections show data dependency rather than a transistor netlist."
  ],
  "omissions": [
    "Input thresholds and transition limits, supply voltage, output drive, loading, propagation delay, temperature, and power behavior.",
    "A passing Boolean truth table does not verify electrical suitability or pin/package wiring."
  ]

  "requirements": [
    {
      "id": "reset_priority",
      "text": "Valid asserted reset forces low output and discharge on, independently of comparator states.",
      "signals": [
        "out_high",
        "discharge_on"
      ],
      "sourceRefs": [
        "ti_555"
      ]
    },
    {
      "id": "trigger_priority",
      "text": "With reset released and CONT at its nominal value, trigger below VCC/3 sets output high regardless of threshold.",
      "signals": [
        "trigger_low",
        "out_high",
        "discharge_on"
      ],
      "sourceRefs": [
        "ti_555"
      ]
    },
    {
      "id": "threshold_reset",
      "text": "Inactive trigger and threshold above 2VCC/3 produce low output and discharge on.",
      "signals": [
        "threshold_high",
        "out_high",
        "discharge_on"
      ],
      "sourceRefs": [
        "ti_555"
      ]
    },
    {
      "id": "hold_state",
      "text": "Inactive trigger and threshold below 2VCC/3 retain the previously established state.",
      "signals": [
        "latch_q",
        "out_high"
      ],
      "sourceRefs": [
        "ti_555"
      ]
    },
    {
      "id": "unspecified_state",
      "text": "Model policy: unspecified power-on state and exact nominal comparator equality are X, not invented guarantees.",
      "signals": [
        "latch_q",
        "trigger_low",
        "threshold_high"
      ],
      "sourceRefs": [
        "ti_555"
      ]
    }
  ],
  "vectors": [
    {
      "id": "reset",
      "label": "Reset overrides both comparators",
      "requirements": [
        "reset_priority"
      ],
      "steps": [
        {
          "set": {
            "reset_n": false,
            "trigger": 0.1,
            "threshold": 0.9
          },
          "expect": {
            "out_high": false,
            "discharge_on": true
          }
        },
        {
          "set": {
            "trigger": 0.8,
            "threshold": 0.1
          },
          "expect": {
            "out_high": false,
            "discharge_on": true
          }
        }
      ]
    },
    {
      "id": "trigger",
      "label": "Trigger priority and release",
      "requirements": [
        "trigger_priority",
        "hold_state"
      ],
      "steps": [
        {
          "set": {
            "trigger": 0.1,
            "threshold": 0.9
          },
          "expect": {
            "trigger_low": true,
            "out_high": true,
            "discharge_on": false
          }
        },
        {
          "set": {
            "trigger": 0.6,
            "threshold": 0.5
          },
          "expect": {
            "latch_q": true,
            "out_high": true
          }
        }
      ]
    },
    {
      "id": "threshold",
      "label": "Threshold clears a set latch",
      "requirements": [
        "threshold_reset",
        "hold_state"
      ],
      "steps": [
        {
          "set": {
            "trigger": 0.1
          },
          "expect": {
            "out_high": true
          }
        },
        {
          "set": {
            "trigger": 0.6,
            "threshold": 0.9
          },
          "expect": {
            "threshold_high": true,
            "out_high": false,
            "discharge_on": true
          }
        },
        {
          "set": {
            "threshold": 0.4
          },
          "expect": {
            "latch_q": false,
            "out_high": false
          }
        }
      ]
    },
    {
      "id": "unknown",
      "label": "Unknown startup and equality",
      "requirements": [
        "unspecified_state"
      ],
      "steps": [
        {
          "set": {},
          "expect": {
            "latch_q": "X",
            "out_high": "X",
            "trigger_low": false,
            "threshold_high": false
          }
        },
        {
          "set": {
            "trigger": 0.3333333333333333,
            "threshold": 0.6666666666666666
          },
          "expect": {
            "latch_q": "X",
            "trigger_low": "X",
            "threshold_high": "X"
          }
        }
      ]
    }
  ],
  "assumptions": [
    "VCC is constant and within the recommended range; normalized inputs refer to that supply.",
    "CONT is open or at nominal 2VCC/3, as required by Table 6-1 note 2 for trigger priority.",
    "RESET is an already-classified valid Boolean input; its analog threshold is not simulated.",
    "Zero-delay event steps model settled behavior only. Comparator equality and unspecified power-on state remain X."
  ],
  "omissions": [
    "RC charging and oscillator timing, analog waveforms, comparator tolerances, propagation delays, minimum pulse widths, and metastability.",
    "Electrical output levels/current, discharge resistance, absolute maximum ratings, temperature behavior, supply ramp, and CONT modulation.",
    "No transistor netlist or electrical equivalence proof; passing vectors covers only the declared function-table abstraction."
  ]
}

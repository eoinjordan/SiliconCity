<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SiliconCity" Manufacturer="SiliconCity contributors" Version="$(Version)" UpgradeCode="8594FBAC-27ED-435C-9379-717F60CFC275" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of SiliconCity is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SiliconCity" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="SiliconCity">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="LaunchShortcut" Name="SiliconCity" Target="[INSTALLFOLDER]SiliconCity.exe" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveShortcuts" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\SiliconCity" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Application" Title="SiliconCity" Level="1">
      <Files Include="$(PublishDir)\**" Directory="INSTALLFOLDER">
        <Exclude Files="**\*.pdb" />
      </Files>
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
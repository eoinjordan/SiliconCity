    {
      "id": "latch_q",
      "label": "Timer state",
      "kind": "latch",
      "initial": "X",
      "group": "storage",
      "description": "Reset first; then active trigger sets; then active threshold clears; otherwise retain the previous state. Initial state is intentionally unspecified.",
      "rule": {
        "op": "if",
        "args": [
          {
            "var": "reset_active"
          },
          false,
          {
            "op": "if",
            "args": [
              {
                "var": "trigger_low"
              },
              true,
              {
                "op": "if",
                "args": [
                  {
                    "var": "threshold_high"
                  },
                  false,
                  {
                    "var": "latch_q"
                  }
                ]
              }
            ]
          }
        ]
      },
      "sourceRefs": [
